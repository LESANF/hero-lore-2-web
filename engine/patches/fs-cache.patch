+// IndexedDB (write-through), so persistence is unchanged.
 pub struct WebFilesystem {
     store: Rc<RefCell<Option<Store>>>,
+    cache: Rc<RefCell<HashMap<(String, String), Option<Vec<u8>>>>>,
