+    async fn load(&self, aid: &str, path: &str) -> Option<Vec<u8>> {
+        let key = (aid.to_string(), path.to_string());
+        if let Some(hit) = self.cache.borrow().get(&key) {
+            return hit.clone();
+        }
+        let data = self.store().await.get(make_key(aid, path)).await;
+        self.cache.borrow_mut().insert(key, data.clone());
+        data
+    }
